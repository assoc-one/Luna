# Luna — environment variables
#
# Copy to .env.local and fill in. `.env.local` is gitignored; this file is not,
# and it must never carry a real value (convention-secrets).
#
# Every variable below is populated by APP-1034 (Vercel project + credentials).
# Nothing in APP-59's scaffold requires them at build time — they are read
# lazily at request time by src/lib/env.ts, which throws a named error if one
# is missing rather than degrading silently.

# --- Anthropic (Claude conversation + plan generation) ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (Luna's voice — TTS streaming) ---
ELEVENLABS_API_KEY=

# --- Vercel KV (anonymous session + state layer) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
