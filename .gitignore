# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example carries variable NAMES only, never values, and is the
# documented list of what a deployment needs (convention-secrets). Commit it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — agent worktrees
# Subagents running with worktree isolation create .claude/worktrees/<agent-id>/
# inside the repo. It is transient and auto-cleaned, but while it exists it shows
# as untracked and trips the session's git-status stop hook. Nothing under
# .claude/ is tracked here, so nothing stops being visible to git status.
.claude/
